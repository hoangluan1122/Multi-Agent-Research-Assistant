# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database Configuration (PostgreSQL Async default or SQLite)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paperflow

# Qdrant Vector DB (supports local memory, docker, or cloud)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_USE_MEMORY=True
QDRANT_COLLECTION_NAME=paperflow_chunks

# LLM Providers Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Multi-Agent Execution Settings
MAX_SEARCH_PAPERS=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_REVIEW_RETRIES=2
