DEBUG=false

# Keep this false for local runs if your shell has broken HTTP_PROXY/HTTPS_PROXY values.
ACADEMIC_SEARCH_TRUST_ENV=false
ACADEMIC_SEARCH_TIMEOUT_SECONDS=30
ACADEMIC_SEARCH_MAX_RETRIES=2
ACADEMIC_SEARCH_OPENALEX_FALLBACK=true
ACADEMIC_SEARCH_CACHE_TTL_SECONDS=900
ACADEMIC_SEARCH_CACHE_MAX_ENTRIES=128
ACADEMIC_SEARCH_CANDIDATE_MULTIPLIER=4
ACADEMIC_SEARCH_MIN_CANDIDATES_PER_SOURCE=30
ACADEMIC_SEARCH_MAX_CANDIDATES_PER_SOURCE=40
ACADEMIC_SEARCH_MIN_RELEVANCE_SCORE=0.45
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3.2
SEMANTIC_SCHOLAR_MIN_REQUEST_INTERVAL_SECONDS=1.1
OPENALEX_MIN_REQUEST_INTERVAL_SECONDS=0.2

# Optional but recommended to avoid Semantic Scholar public rate limits.
# Official header used by the backend: x-api-key
SEMANTIC_SCHOLAR_API_KEY=

# Optional OpenAlex key for higher quota on the real metadata fallback.
OPENALEX_API_KEY=

# Optional LLM keys.
GEMINI_API_KEY=
OPENAI_API_KEY=
